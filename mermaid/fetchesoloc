#! /bin/zsh
#
# Pull all "????_all.txt" MERMAID-location text files from EarthScopeOceans.org
#
# Author: Joel D. Simon <jdsimon@bathymetrix.com>
# Last modified: 30-Jun-2026, Darwin Kernel Version 23.6.0

OUTDIR=$MERMAID/esoloc/

wget --recursive \
     --no-parent \
     --no-host-directories \
     --cut-dirs=3 \
     --directory-prefix=$OUTDIR \
     --accept '?????_all.txt' \
     http://geoweb.princeton.edu/people/simons/SOM/

rm -rf $OUTDIR/inprogress
